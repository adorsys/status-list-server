{
  "name": "status-list-performance-tests",
  "version": "1.0.0",
  "description": "Performance tests for Status List Server using Artillery",
  "scripts": {
    "generate-tokens": "node ./scripts/token-generator.js",
    "test:load": "artillery run ./tests/load-test.yml",
    "test:stress": "artillery run ./tests/stress-test.yml",
    "test:spike": "artillery run ./tests/spike-test.yml",
    "test:auth": "artillery run ./tests/auth-test.yml",
    "test:all": "npm run test:load && npm run test:stress && npm run test:spike && npm run test:auth",
    "test:load:report": "node -e \"require('fs').mkdirSync('results',{recursive:true})\" && artillery run --output results/load-test.json ./tests/load-test.yml",
    "test:stress:report": "node -e \"require('fs').mkdirSync('results',{recursive:true})\" && artillery run --output results/stress-test.json ./tests/stress-test.yml",
    "test:spike:report": "node -e \"require('fs').mkdirSync('results',{recursive:true})\" && artillery run --output results/spike-test.json ./tests/spike-test.yml",
    "test:auth:report": "node -e \"require('fs').mkdirSync('results',{recursive:true})\" && artillery run --output results/auth-test.json ./tests/auth-test.yml"
  },
  "devDependencies": {
    "artillery": "^2.0.34",
    "artillery-plugin-metrics-by-endpoint": "^1.27.0",
    "artillery-plugin-statsd": "^2.2.1"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3"
  }
}
