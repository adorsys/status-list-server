#====================================================
# Application specific configuration
#====================================================
RUST_LOG=info
APP_ENV=development # development | production

APP_SERVER__HOST=0.0.0.0
APP_SERVER__DOMAIN=statuslist.example.com
APP_SERVER__PORT=8000
APP_SERVER__ENABLE_METRICS=false
# OPTIONAL: URI of the Status List Aggregation endpoint (draft-21 §9). Unset to omit from tokens.
# APP_SERVER__AGGREGATION_URI=https://statuslist.example.com/api/v1/aggregation

# Certificate provisioning
# acme: server requests/renews certificates through ACME.
# store: server loads externally managed certificate/key material from filesystem or configured storage.
APP_SERVER__CERT__PROVISIONING_STRATEGY=acme

# ACME settings. Required only when APP_SERVER__CERT__PROVISIONING_STRATEGY=acme.
APP_SERVER__CERT__EMAIL=support@example.com
APP_SERVER__CERT__ORGANIZATION=example.com
# (or https://acme-v02.api.letsencrypt.org/directory in production)
APP_SERVER__CERT__ACME_DIRECTORY_URL=https://pebble:14000/dir
# The last number is not explicitly defined in the spec
APP_SERVER__CERT__EKU=1,3,6,1,5,5,7,3,30
# The cryptographic material backend is selected by enabled Cargo features:
# vault => Vault/OpenBao; aws-secrets without vault => AWS Secrets Manager;
# neither feature => in-memory storage for local development and tests.
# Certificate material stays cached until provisioning or renewal invalidates it.
# TTL in seconds for private signing-key reads from the selected backend.
# Set to 0 to force every private-key read to the backend.
APP_SERVER__CERT__SIGNING_KEY_CACHE_TTL=0
# Cron schedule for certificate renewal checks (6-field cron: sec min hour day month day-of-week)
APP_SERVER__CERT__RENEWAL_CRON_SCHEDULE=0 0 0 * * *
# Parsed certificate chains stay cached until certificate provisioning or renewal replaces them.
# DNS challenge server URL. Optional; only used in development mode (APP_ENV=development).
# Falls back to http://challtestsrv:8055 when unset.
# APP_SERVER__CERT__DNS_CHALLENGE_SERVER_URL=http://challtestsrv:8055

# Store provisioning settings. Required only when APP_SERVER__CERT__PROVISIONING_STRATEGY=store.
# Configure either filesystem paths or storage keys, not both.
# Filesystem values may contain PEM text or raw DER.
# Storage-backed values may contain PEM text or base64/base64url-encoded DER.
# Private keys must be PKCS#8 PEM or DER.
# Filesystem provisioning:
# APP_SERVER__CERT__STORE__CERTIFICATE_PATH=/etc/status-list/tls.crt
# APP_SERVER__CERT__STORE__SIGNING_KEY_PATH=/etc/status-list/tls.key
# Storage-backed provisioning from the selected cryptographic material backend:
# APP_SERVER__CERT__STORE__CERTIFICATE_KEY=status-list/server-certificate
# APP_SERVER__CERT__STORE__SIGNING_KEY_KEY=status-list/server-signing-key

# DNS provider for ACME DNS-01 challenges: route53 | cloudflare | gcloud | azure | acmedns | pebble
# When unset: route53 in production, pebble in development.
# See docs/dns-providers.md for setup instructions per provider.
# APP_SERVER__CERT__DNS__PROVIDER=route53
#
# Cloudflare (API token with Zone:Read and DNS:Edit permissions)
# APP_SERVER__CERT__DNS__CLOUDFLARE__API_TOKEN=
#
# Google Cloud DNS (service account key JSON, inline or as a file path)
# APP_SERVER__CERT__DNS__GCLOUD__SERVICE_ACCOUNT_KEY=
# APP_SERVER__CERT__DNS__GCLOUD__SERVICE_ACCOUNT_KEY_PATH=
#
# Azure DNS (service principal with the DNS Zone Contributor role)
# APP_SERVER__CERT__DNS__AZURE__TENANT_ID=
# APP_SERVER__CERT__DNS__AZURE__CLIENT_ID=
# APP_SERVER__CERT__DNS__AZURE__CLIENT_SECRET=
# APP_SERVER__CERT__DNS__AZURE__SUBSCRIPTION_ID=
# APP_SERVER__CERT__DNS__AZURE__RESOURCE_GROUP=
#
# ACME-DNS (self-hosted, credentials from the /register response)
# APP_SERVER__CERT__DNS__ACMEDNS__SERVER_URL=
# Default account (used for domains without a per-domain entry below)
# APP_SERVER__CERT__DNS__ACMEDNS__USERNAME=
# APP_SERVER__CERT__DNS__ACMEDNS__PASSWORD=
# APP_SERVER__CERT__DNS__ACMEDNS__SUBDOMAIN=
# Optional per-domain accounts as a JSON object (one registration per domain),
# e.g. {"a.example.com": {"username": "u", "password": "p", "subdomain": "s"}}
# APP_SERVER__CERT__DNS__ACMEDNS__ACCOUNTS=

# Database backend: postgres | mysql | sqlite.
APP_DATABASE__BACKEND=postgres
# Prefer split fields in Kubernetes so pod metadata does not expose a fully
# assembled credential-bearing URL. APP_DATABASE__PASSWORD should come from a
# secret manager or orchestrator secret, not a checked-in env file.
APP_DATABASE__HOST=db
APP_DATABASE__PORT=5432
APP_DATABASE__USERNAME=postgres
APP_DATABASE__PASSWORD=postgres
APP_DATABASE__NAME=status-list
# Optional non-secret driver/TLS query parameters, for example:
# APP_DATABASE__QUERY=sslmode=verify-full&sslrootcert=/var/run/postgres/ca.crt
# APP_DATABASE__URL remains supported for local/custom deployments, but do not
# combine it with split database fields.
# For MySQL:
#   APP_DATABASE__BACKEND=mysql
#   APP_DATABASE__HOST=mysql
#   APP_DATABASE__PORT=3306
#   APP_DATABASE__USERNAME=mysql
#   APP_DATABASE__PASSWORD=mysql
#   APP_DATABASE__NAME=status-list
# MariaDB-compatible servers also use the MySQL backend and a mysql:// URL.
# For example, set:
#   APP_DATABASE__BACKEND=mysql
#   APP_DATABASE__HOST=your-db-host
# For SQLite (in-memory for testing) — use a shared cache with a single
# connection pool to avoid "database is locked" errors:
#   APP_DATABASE__URL=sqlite::memory:?cache=shared
#   APP_DATABASE__BACKEND=sqlite

# Connection pool (Postgres / MySQL).
# Size max_connections as: floor(server_max_connections / replica_count) - headroom
# Example: Postgres max_connections=100, 2 replicas → 100/2 - 5 = 45
APP_DATABASE__POOL__MAX_CONNECTIONS=5
APP_DATABASE__POOL__MIN_CONNECTIONS=1
# Seconds to wait for a free connection before returning an error (prevents indefinite queuing)
APP_DATABASE__POOL__ACQUIRE_TIMEOUT_SECS=5
APP_DATABASE__POOL__CONNECT_TIMEOUT_SECS=10
APP_DATABASE__POOL__IDLE_TIMEOUT_SECS=600
APP_DATABASE__POOL__MAX_LIFETIME_SECS=1800

# AWS SDK
APP_AWS__REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566 # remove this in production
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Vault / OpenBao KV v2 configuration (feature = "vault")
# When compiled with the `vault` feature, Vault/OpenBao can be selected as the
# cryptographic material backend for certificate and signing-key material.
# Authentication is supported via AppRole or Kubernetes auth methods.
#
# Authentication method: approle (default) | kubernetes
# APP_VAULT__AUTH_METHOD=approle
#
# Vault/OpenBao API address
# APP_VAULT__ADDR=http://vault:8200
#
# AppRole configuration (when APP_VAULT__AUTH_METHOD=approle):
# APP_VAULT__AUTH_MOUNT=approle
# APP_VAULT__ROLE_ID=
# APP_VAULT__SECRET_ID=
# Alternatively, specify a file path to load secret_id from disk:
# APP_VAULT__SECRET_ID_PATH=/vault/secrets/secret-id
# Note on production security: Never hard-code or store secret_id in plain text.
# Deliver secret_id via a secrets injector (Vault Agent, K8s Secret CSI, volume mount, etc.).
#
# Kubernetes auth configuration (when APP_VAULT__AUTH_METHOD=kubernetes):
# APP_VAULT__K8S_ROLE=
# APP_VAULT__K8S_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
# APP_VAULT__K8S_AUTH_MOUNT=kubernetes
#
# KV v2 engine mount path
# APP_VAULT__MOUNT=secret
# Path prefix prepended to all secret keys
# APP_VAULT__PATH_PREFIX=
# Vault Enterprise / OpenBao namespace (default: empty / unset)
# APP_VAULT__NAMESPACE=
# HTTP request timeout in seconds
# APP_VAULT__TIMEOUT_SECS=30

# Cache configuration
# TTL for the status list record cache. 
# Set to 0 to disable and always fetch from the database.
APP_CACHE__TTL=300
APP_CACHE__MAX_CAPACITY=100

# Status list token configuration
# Token expiration in seconds (time from issuance until expiry)
APP_STATUS_LIST__TOKEN_EXP_SECS=900
# Token TTL in seconds (advertised lifetime of the status list token)
APP_STATUS_LIST__TOKEN_TTL_SECS=300
# Retention period for snapshots in seconds (default 90 days).
# Set to 0 to disable snapshots entirely (draft-21 §12.7 privacy note).
# DEPRECATED: APP_STATUS_LIST__HISTORY_RETENTION_SECS is still accepted but
# will be removed in a future release.
APP_STATUS_LIST__SNAPSHOT_RETENTION_SECS=7776000

# Rate limiting (#171): strict (write endpoints), permissive (public reads)
APP_RATE_LIMIT__STRICT_BURST_SIZE=10
APP_RATE_LIMIT__STRICT_PERIOD_SECS=60
APP_RATE_LIMIT__PERMISSIVE_BURST_SIZE=100
APP_RATE_LIMIT__PERMISSIVE_PERIOD_SECS=60

# Hard bounds (#171)
APP_LIMITS__MAX_BODY_SIZE_BYTES=2097152 # 2 MiB
APP_LIMITS__MAX_STATUS_INDEX=100000
APP_LIMITS__MAX_STATUSES_PER_REQUEST=5000
APP_LIMITS__MAX_SERIALIZED_LIST_SIZE=1048576 # 1 MiB

#====================================================
# Telemetry / OpenTelemetry configuration
#====================================================
# Telemetry environment: "development" (stdout only) or "production" (OTLP export)
APP_TELEMETRY__ENVIRONMENT=development
# OTLP gRPC endpoint for trace export (production mode only)
APP_TELEMETRY__OTLP_ENDPOINT=http://otel-collector:4317
# Trace sampling ratio (0.0–1.0, default 1.0 = sample everything)
APP_TELEMETRY__SAMPLER_RATIO=1.0
# Enable/disable the OpenTelemetry tracing pipeline
APP_TELEMETRY__ENABLED=true

#====================================================
# Docker Compose Postgres service configuration
#====================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=status-list

