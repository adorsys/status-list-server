# Application
RUST_LOG=info
# Application environment: development | production
APP_ENV=development
# Issuer trust registry. Unset: the server trusts no issuers (development
# default). Set to a mounted file to enable management-token authentication.
# APP_MANAGEMENT_AUTH__ISSUERS_FILE=issuer-registry/issuers.yaml
# To use a local issuer registry with Compose, set ISSUER_REGISTRY_DIR and add
# -f compose/issuer-registry.yml to the docker compose command.

APP_SERVER__HOST=0.0.0.0
APP_SERVER__DOMAIN=statuslist.example.com
# Defaults to https://<DOMAIN>/api/v1; set it for a non-443 port or another path.
# APP_SERVER__PUBLIC_BASE_URL=https://statuslist.example.com/api/v1
APP_SERVER__PORT=8000
APP_SERVER__ENABLE_METRICS=true
# Deployment profile: private (default, operator registry only) or hosted (also trusts issuer keys in the SQL hosted issuer store).
# APP_SERVER__PROFILE=private
# Management listener (issuer writes, credentials). Unset means localhost:8001.
APP_SERVER__MANAGEMENT__HOST=0.0.0.0
APP_SERVER__MANAGEMENT__PORT=8001
# Admin listener (/health/ready, /metrics). Unset means localhost:8002.
APP_SERVER__ADMIN__HOST=0.0.0.0
APP_SERVER__ADMIN__PORT=8002
# Service document links (GET /): documentation defaults to the repo URL, portal is omitted when unset.
# APP_SERVER__LINKS__DOCUMENTATION=https://github.com/adorsys/status-list-server
# APP_SERVER__LINKS__PORTAL=https://statuslist.example.com
# Optional aggregation endpoint (draft-21 §9), without a query; tokens get it scoped per issuer.
# APP_SERVER__AGGREGATION_URI=https://statuslist.example.com/api/v1/aggregation

# Builds with the acme feature use ACME; others load PEM from files or inline values.

# ACME builds only.
APP_SERVER__CERT__EMAIL=support@example.com
APP_SERVER__CERT__ORGANIZATION=example.com
# (or https://acme-v02.api.letsencrypt.org/directory in production)
APP_SERVER__CERT__ACME_DIRECTORY_URL=https://pebble:14000/dir
# The last number is not explicitly defined in the spec
APP_SERVER__CERT__EKU=1,3,6,1,5,5,7,3,30
# The secrets backend is the first enabled of vault, gcp, azure, aws; none means in-memory.
# Seconds to cache signing-key reads; 0 reads the backend every time.
APP_SERVER__CERT__SIGNING_KEY_CACHE_TTL=0
# Cron schedule for certificate renewal checks (6-field cron: sec min hour day month day-of-week)
APP_SERVER__CERT__RENEWAL_CRON_SCHEDULE="0 0 0 * * *"
# Dev only; defaults to http://challtestsrv:8055.
# APP_SERVER__CERT__DNS_CHALLENGE_SERVER_URL=http://challtestsrv:8055

# Non-ACME builds: set the two paths or the two storage keys, not both. Values are PEM.
# APP_SERVER__CERT__STORE__CERTIFICATE_PATH=/etc/status-list/tls.crt
# APP_SERVER__CERT__STORE__SIGNING_KEY_PATH=/etc/status-list/tls.key
# APP_SERVER__CERT__STORE__CERTIFICATE_KEY=status-list/server-certificate
# APP_SERVER__CERT__STORE__SIGNING_KEY_KEY=status-list/server-signing-key

# DNS-01 provider: route53 | cloudflare | gcloud | azure | acmedns | pebble (docs/dns-providers.md).
# Defaults to route53 in production and pebble in development.
# APP_SERVER__CERT__DNS__PROVIDER=route53
# APP_SERVER__CERT__DNS__CLOUDFLARE__API_TOKEN=
# APP_SERVER__CERT__DNS__GCLOUD__PROJECT_ID=
# APP_SERVER__CERT__DNS__AZURE__SUBSCRIPTION_ID=
# APP_SERVER__CERT__DNS__AZURE__RESOURCE_GROUP=
# APP_SERVER__CERT__DNS__ACMEDNS__SERVER_URL=
# APP_SERVER__CERT__DNS__ACMEDNS__USERNAME=
# APP_SERVER__CERT__DNS__ACMEDNS__PASSWORD=
# APP_SERVER__CERT__DNS__ACMEDNS__SUBDOMAIN=
# Per-domain accounts as JSON, overriding the default account above for their domains:
# {"a.example.com": {"username": "u", "password": "p", "subdomain": "s"}}
# APP_SERVER__CERT__DNS__ACMEDNS__ACCOUNTS=

# memory | postgres | mysql | sqlite; defaults to the compiled database feature.
# APP_DATABASE__BACKEND=postgres
# Keep APP_DATABASE__PASSWORD out of committed env files.
APP_DATABASE__HOST=db
APP_DATABASE__PORT=5432
APP_DATABASE__USERNAME=postgres
APP_DATABASE__PASSWORD=postgres
APP_DATABASE__NAME=status-list
# Optional driver/TLS parameters, e.g.:
# APP_DATABASE__QUERY=sslmode=verify-full&sslrootcert=/var/run/postgres/ca.crt
# APP_DATABASE__URL also works, but not together with the split fields.
# Prefer the split fields in Kubernetes: a full URL puts the password in pod metadata.
# MySQL and MariaDB: APP_DATABASE__BACKEND=mysql, port 3306.
# In-memory SQLite needs a shared cache to avoid "database is locked":
# APP_DATABASE__URL=sqlite::memory:?cache=shared
# APP_DATABASE__BACKEND=sqlite

# Size as floor(server max_connections / replicas) - headroom, e.g. 100 / 2 - 5 = 45.
APP_DATABASE__POOL__MAX_CONNECTIONS=5
APP_DATABASE__POOL__MIN_CONNECTIONS=1
APP_DATABASE__POOL__ACQUIRE_TIMEOUT_SECS=5
APP_DATABASE__POOL__CONNECT_TIMEOUT_SECS=10
APP_DATABASE__POOL__IDLE_TIMEOUT_SECS=600
APP_DATABASE__POOL__MAX_LIFETIME_SECS=1800

APP_AWS__REGION=us-east-1
# Remove AWS_ENDPOINT_URL in production
AWS_ENDPOINT_URL=http://floci:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Vault / OpenBao (vault feature). Auth: approle (default) or kubernetes.
# APP_VAULT__AUTH_METHOD=approle
# APP_VAULT__ADDR=http://vault:8200
# APP_VAULT__AUTH_MOUNT=approle
# APP_VAULT__ROLE_ID=
# Never commit secret_id; inject it, or point SECRET_ID_PATH at a mounted file.
# APP_VAULT__SECRET_ID=
# APP_VAULT__SECRET_ID_PATH=/vault/secrets/secret-id
# APP_VAULT__K8S_ROLE=
# APP_VAULT__K8S_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
# APP_VAULT__K8S_AUTH_MOUNT=kubernetes
# APP_VAULT__MOUNT=secret
# APP_VAULT__PATH_PREFIX=
# APP_VAULT__NAMESPACE=
# APP_VAULT__TIMEOUT_SECS=30

# memory or redis (needs the redis feature, which release images include).
APP_CACHE__BACKEND=memory
# Status-list cache TTL in seconds; 0 disables the cache.
APP_CACHE__TTL=300
# Ignored by Redis, which expires keys by TTL.
APP_CACHE__MAX_CAPACITY=1000
# Redis (APP_CACHE__BACKEND=redis). Prefer PASSWORD_FILE for mounted secrets.
# APP_CACHE__HOST=redis
# APP_CACHE__PORT=6379
# APP_CACHE__USERNAME=
# APP_CACHE__PASSWORD=
# APP_CACHE__PASSWORD_FILE=/var/run/secrets/status-list/redis-password
# APP_CACHE__DATABASE=0
# APP_CACHE__TLS=false
# APP_CACHE__CA_FILE=/var/run/secrets/status-list/redis-ca.pem
# Give the Redis ACL user only this prefix and the commands listed in README.md.
# APP_CACHE__KEY_PREFIX=status-list-server:status-list:
# APP_CACHE__RESPONSE_TIMEOUT_MS=250
# APP_CACHE__CONNECTION_TIMEOUT_MS=250
# APP_CACHE__RECONNECT_COOLDOWN_MS=250

# Signed token cache budget in bytes (64 MiB); 0 disables it and every request re-signs.
APP_TOKEN_BYTES_CACHE__MAX_CAPACITY=67108864

# Token lifetime (exp) and advertised TTL, in seconds; TTL must be below EXP.
APP_STATUS_LIST__TOKEN_EXP_SECS=900
APP_STATUS_LIST__TOKEN_TTL_SECS=300
# Snapshot retention in seconds (90 days); 0 disables snapshots (draft-21 §12.7).
# HISTORY_RETENTION_SECS is a deprecated alias.
APP_STATUS_LIST__SNAPSHOT_RETENTION_SECS=7776000

# Management JWT checks: clock-skew leeway and max lifetime (exp - iat), in seconds.
APP_MANAGEMENT_AUTH__LEEWAY_SECS=60
APP_MANAGEMENT_AUTH__MAX_TOKEN_LIFETIME_SECS=300
# Comma-separated aud values. Required in production; empty skips the check only in development.
APP_MANAGEMENT_AUTH__AUDIENCES=

# Rate limits: strict for writes, permissive for public reads.
APP_RATE_LIMIT__STRICT_BURST_SIZE=10
APP_RATE_LIMIT__STRICT_PERIOD_SECS=60
APP_RATE_LIMIT__PERMISSIVE_BURST_SIZE=100
APP_RATE_LIMIT__PERMISSIVE_PERIOD_SECS=60

APP_LIMITS__MAX_BODY_SIZE_BYTES=2097152
APP_LIMITS__MAX_STATUS_INDEX=100000
APP_LIMITS__MAX_STATUSES_PER_REQUEST=5000
APP_LIMITS__MAX_SERIALIZED_LIST_SIZE=1048576
# At most 1000 (one aggregation page); lists can't be deleted via the API (docs/troubleshooting.md).
APP_LIMITS__MAX_LISTS_PER_ISSUER=1000

# Telemetry
# development or production; only changes the log format.
APP_TELEMETRY__ENVIRONMENT=development
APP_TELEMETRY__OTLP_ENDPOINT=http://otel-collector:4317
APP_TELEMETRY__SAMPLER_RATIO=1.0
APP_TELEMETRY__ENABLED=false

# Docker Compose Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=status-list

# Docker Compose MySQL
# MYSQL_ROOT_PASSWORD=rootpassword
# MYSQL_DATABASE=status-list
# MYSQL_USER=mysql
# MYSQL_PASSWORD=mysql

# The observability profile needs ALERTMANAGER_PLATFORM, its webhook URL and GRAFANA_ADMIN_PASSWORD.

# Alertmanager: set ALERTMANAGER_PLATFORM and its credential, or no alerts go out.
# Keep real webhook URLs out of git.
# ALERTMANAGER_PLATFORM=discord
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_ME
# MS_TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/REPLACE_ME
# MATTERMOST_WEBHOOK_URL=https://mattermost.example.com/hooks/REPLACE_ME
# ALERTMANAGER_WEBHOOK_URL=https://example.com/webhooks/REPLACE_ME
# ALERTMANAGER_EMAIL_TO=ops@example.com
# ALERTMANAGER_SMTP_HOST=smtp.example.com
# ALERTMANAGER_SMTP_PORT=587
# ALERTMANAGER_SMTP_FROM=alertmanager@example.com
# Dead man's switch for the always-firing Watchdog; unset, it's silently dropped.
# ALERTMANAGER_DMS_WEBHOOK_URL=https://hc-ping.com/<UUID>

# Grafana admin password (user admin); without it Grafana restart-loops while up -d looks fine.
# GRAFANA_ADMIN_PASSWORD=admin
