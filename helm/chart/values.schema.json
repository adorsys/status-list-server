{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "automountServiceAccountToken": { "type": "boolean" },
        "annotations": { "type": "object" },
        "labels": { "type": "object" }
      }
    },
    "statuslist": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer" },
        "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "aws": {
          "type": "object",
          "properties": {
            "mountCredentials": { "type": "boolean" },
            "credentialsSecret": {
              "type": "object",
              "properties": {
                "remoteKey": { "type": "string" },
                "credentialsProperty": { "type": "string" },
                "configProperty": { "type": "string" },
                "targetTemplate": { "type": "object" }
              }
            },
            "region": { "type": "string" }
          }
        },
        "fallbackSecret": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "stringData": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "secretMounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "secretName", "mountPath"],
            "properties": {
              "name": { "type": "string" },
              "secretName": { "type": "string" },
              "mountPath": { "type": "string" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["key", "path"],
                  "properties": {
                    "key": { "type": "string" },
                    "path": { "type": "string" }
                  }
                }
              },
              "fileEnv": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          }
        },
        "watcher": {
          "type": "object",
          "properties": {
            "pollIntervalSecs": { "type": ["string", "integer"] }
          }
        }
      }
    },
    "externalSecret": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "spec": {
          "type": "object",
          "properties": {
            "secretStoreRef": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "kind": { "type": "string" }
              }
            },
            "target": {
              "type": "object",
              "properties": {
                "name": { "const": "statuslist-secret" },
                "creationPolicy": { "type": "string" },
                "template": { "type": "object" }
              }
            },
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["secretKey", "remoteRef"],
                "properties": {
                  "secretKey": { "type": "string" },
                  "remoteRef": { "type": "object" }
                }
              }
            },
            "extraExternalSecrets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["metadata", "spec"],
                "properties": {
                  "metadata": {
                    "type": "object",
                    "required": ["name"],
                    "properties": {
                      "name": { "type": "string" },
                      "labels": { "type": "object" },
                      "annotations": { "type": "object" }
                    }
                  },
                  "spec": {
                    "type": "object",
                    "required": ["target"],
                    "properties": {
                      "refreshInterval": { "type": "string" },
                      "secretStoreRef": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "kind": { "type": "string" }
                        }
                      },
                      "target": {
                        "type": "object",
                        "required": ["name"],
                        "properties": {
                          "name": { "type": "string" },
                          "creationPolicy": { "type": "string" },
                          "template": { "type": "object" }
                        }
                      },
                      "data": { "type": "array" },
                      "dataFrom": { "type": "array" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "secretStore": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": {
          "type": "string",
          "enum": ["aws", "vault", "gcp", "azure", "raw"]
        },
        "aws": {
          "type": "object",
          "properties": {
            "service": { "type": "string", "enum": ["SecretsManager", "ParameterStore"] },
            "region": { "type": "string" }
          }
        },
        "vault": {
          "type": "object",
          "properties": {
            "server": { "type": "string" },
            "path": { "type": "string" },
            "auth": { "type": "object" }
          }
        },
        "gcp": {
          "type": "object",
          "properties": {
            "projectID": { "type": "string" },
            "auth": { "type": "object" }
          }
        },
        "azure": {
          "type": "object",
          "properties": {
            "tenantId": { "type": "string" },
            "vaultUrl": { "type": "string" },
            "authType": { "type": "string", "enum": ["", "ServicePrincipal", "ManagedIdentity", "WorkloadIdentity"] },
            "environmentType": { "type": "string" },
            "identityId": { "type": "string" },
            "serviceAccountRef": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "namespace": { "type": ["string", "null"] }
              }
            },
            "authSecretRef": { "type": "object" }
          }
        },
        "raw": {
          "type": "object",
          "description": "Full ESO provider spec passthrough for unsupported providers (secretStore.provider=raw). Holds ONLY the concrete provider body rendered directly under spec.provider (no extra top-level 'provider' key), e.g. { webhook: { url: '...' } }. Render-time validation rejects an empty/raw-only object to avoid emitting an insecure SecretStore."
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "metrics": { "type": "array" },
        "behavior": { "type": "object" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      }
    },
    "alerting": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "platform": {
          "type": "string",
          "enum": ["slack", "discord", "teams", "mattermost", "email", "webhook", ""]
        },
        "labels": { "type": "object" },
        "existingSecret": { "type": "string" },
        "webhookUrl": { "type": "string" },
        "dmsWebhookUrl": { "type": "string" },
        "email": {
          "type": "object",
          "properties": {
            "to": { "type": "string" },
            "smtpHost": { "type": "string" },
            "smtpPort": { "type": "string" },
            "smtpFrom": { "type": "string" },
            "requireTls": { "type": "boolean" }
          }
        }
      }
    }
  }
}
