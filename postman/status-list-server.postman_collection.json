                "exec": [
                  "pm.test('update succeeds or reports an expected API error', function () { pm.expect([200, 400, 401, 403, 404, 409, 422]).to.include(pm.response.code); });",
                  "pm.test('empty body on success, JSON on error', function () {",
                  "  if (pm.response.code === 200) { pm.expect(pm.response.text()).to.equal(''); }",
                  "  if (pm.response.code >= 400) { pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'); }",
                  "});"
