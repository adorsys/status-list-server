              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('publish creates the status list', function () { pm.response.to.have.status(201); });",
                  "pm.test('publish response is empty or describes the stored list', function () {",
                  "  var text = pm.response.text();",
                  "  if (!text) { return; }",
                  "  var body = pm.response.json();",
