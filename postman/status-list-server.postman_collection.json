          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('historical resolution succeeds', function () { pm.response.to.have.status(200); });",
                  "pm.test('historical success has immutable cache headers', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/statuslist+jwt');",
                  "  pm.expect(pm.response.headers.has('ETag')).to.equal(true);",
                  "  pm.expect(pm.response.headers.get('Cache-Control') || '').to.include('immutable');",
                  "});",
                  "pm.test('historical response keeps the pre-update snapshot timestamp', function () {",
                  "  pm.expect(pm.response.headers.get('Last-Modified')).to.equal(pm.collectionVariables.get('pre_update_last_modified') || pm.environment.get('pre_update_last_modified'));",
                  "  pm.expect(pm.response.headers.get('Last-Modified')).to.not.equal(pm.collectionVariables.get('post_update_last_modified') || pm.environment.get('post_update_last_modified'));",
                  "});",
                  "function decodeJwtPayload(token) {",
                  "  var parts = token.split('.');",
                  "  pm.expect(parts, 'JWT has three segments').to.have.length(3);",
                  "  var payload = parts[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "  while (payload.length % 4) { payload += '='; }",
                  "  var json = typeof Buffer !== 'undefined' ? Buffer.from(payload, 'base64').toString('utf8') : atob(payload);",
                  "  return JSON.parse(json);",
                  "}",
                  "pm.test('historical JWT payload keeps status values [0, 1, 2]', function () {",
                  "  var payload = decodeJwtPayload(pm.response.text());",
                  "  pm.expect(payload).to.have.property('status_list');",
