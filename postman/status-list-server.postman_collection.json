        {
          "name": "Retrieve status list as JWT",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/statuslist+jwt"
              },
              {
                "key": "Accept-Encoding",
                "value": "identity"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/status-lists/{{list_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "status-lists",
                "{{list_id}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('JWT retrieval succeeds', function () { pm.response.to.have.status(200); });",
                  "pm.test('JWT success has status-list headers', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/statuslist+jwt');",
                  "  pm.expect(pm.response.headers.has('ETag')).to.equal(true);",
                  "  pm.expect(pm.response.headers.has('Last-Modified')).to.equal(true);",
                  "  pm.expect(pm.response.headers.get('Vary') || '').to.include('Accept');",
                  "});",
                  "function decodeJwtPayload(token) {",
                  "  var parts = token.split('.');",
                  "  pm.expect(parts, 'JWT has three segments').to.have.length(3);",
                  "  var payload = parts[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "  while (payload.length % 4) { payload += '='; }",
                  "  var json = typeof Buffer !== 'undefined' ? Buffer.from(payload, 'base64').toString('utf8') : atob(payload);",
                  "  return JSON.parse(json);",
                  "}",
                  "pm.test('JWT payload has published status values [0, 1, 2]', function () {",
                  "  var payload = decodeJwtPayload(pm.response.text());",
                  "  pm.expect(payload).to.have.property('status_list');",
                  "  pm.expect(payload.status_list).to.include({ bits: 2, lst: 'eNpTAQAAJQAl' });",
                  "  pm.collectionVariables.set('pre_update_status_list_lst', payload.status_list.lst);",
                  "  pm.environment.set('pre_update_status_list_lst', payload.status_list.lst);",
                  "});",
                  "var preUpdateLastModified = pm.response.headers.get('Last-Modified') || '';",
                  "var historicalTime = Math.floor(Date.parse(preUpdateLastModified) / 1000).toString();",
                  "pm.test('pre-update server timestamp is usable for history lookup', function () {",
                  "  pm.expect(historicalTime).to.not.equal('NaN');",
                  "});",
                  "pm.collectionVariables.set('historical_time', historicalTime);",
                  "pm.environment.set('historical_time', historicalTime);",
                  "pm.collectionVariables.set('pre_update_etag', pm.response.headers.get('ETag') || '');",
                  "pm.collectionVariables.set('pre_update_last_modified', pm.response.headers.get('Last-Modified') || '');",
                  "pm.environment.set('pre_update_etag', pm.response.headers.get('ETag') || '');",
                  "pm.environment.set('pre_update_last_modified', pm.response.headers.get('Last-Modified') || '');"
                ]
              }
            }
          ]
