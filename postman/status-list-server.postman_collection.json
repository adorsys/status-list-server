        {
          "name": "Retrieve updated status list as JWT",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/statuslist+jwt"
              },
              {
                "key": "Accept-Encoding",
                "value": "identity"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/status-lists/{{list_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "status-lists",
                "{{list_id}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('updated JWT retrieval succeeds', function () { pm.response.to.have.status(200); });",
                  "pm.test('updated JWT has fresh validators', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/statuslist+jwt');",
                  "  pm.expect(pm.response.headers.has('ETag')).to.equal(true);",
                  "  pm.expect(pm.response.headers.has('Last-Modified')).to.equal(true);",
                  "  pm.expect(pm.response.headers.get('ETag')).to.not.equal(pm.collectionVariables.get('pre_update_etag') || pm.environment.get('pre_update_etag'));",
                  "  pm.expect(pm.response.headers.get('Last-Modified')).to.not.equal(pm.collectionVariables.get('pre_update_last_modified') || pm.environment.get('pre_update_last_modified'));",
                  "});",
                  "function decodeJwtPayload(token) {",
                  "  var parts = token.split('.');",
                  "  pm.expect(parts, 'JWT has three segments').to.have.length(3);",
                  "  var payload = parts[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "  while (payload.length % 4) { payload += '='; }",
                  "  var json = typeof Buffer !== 'undefined' ? Buffer.from(payload, 'base64').toString('utf8') : atob(payload);",
                  "  return JSON.parse(json);",
                  "}",
                  "pm.test('updated JWT payload has status values [0, 2, 2]', function () {",
                  "  var payload = decodeJwtPayload(pm.response.text());",
                  "  pm.expect(payload).to.have.property('status_list');",
                  "  pm.expect(payload.status_list).to.include({ bits: 2, lst: 'eNrTAAAAKQAp' });",
                  "  pm.expect(payload.status_list.lst).to.not.equal(pm.collectionVariables.get('pre_update_status_list_lst') || pm.environment.get('pre_update_status_list_lst'));",
                  "  pm.collectionVariables.set('post_update_status_list_lst', payload.status_list.lst);",
                  "  pm.environment.set('post_update_status_list_lst', payload.status_list.lst);",
                  "});",
                  "pm.collectionVariables.set('post_update_etag', pm.response.headers.get('ETag') || '');",
                  "pm.collectionVariables.set('post_update_last_modified', pm.response.headers.get('Last-Modified') || '');",
                  "pm.environment.set('post_update_etag', pm.response.headers.get('ETag') || '');",
                  "pm.environment.set('post_update_last_modified', pm.response.headers.get('Last-Modified') || '');"
                ]
              }
            }
          ]
