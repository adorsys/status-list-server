                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve status list as JWT",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/statuslist+jwt"
              },
              {
                "key": "Accept-Encoding",
                "value": "identity"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/status-lists/{{list_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "status-lists",
                "{{list_id}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('JWT retrieval succeeds', function () { pm.response.to.have.status(200); });",
                  "pm.test('JWT success has status-list headers', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/statuslist+jwt');",
                  "  pm.expect(pm.response.headers.has('ETag')).to.equal(true);",
                  "  pm.expect(pm.response.headers.has('Last-Modified')).to.equal(true);",
                  "  pm.expect(pm.response.headers.get('Vary') || '').to.include('Accept');",
                  "});",
                  "function decodeJwtPayload(token) {",
                  "  var parts = token.split('.');",
                  "  pm.expect(parts, 'JWT has three segments').to.have.length(3);",
                  "  var payload = parts[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "  while (payload.length % 4) { payload += '='; }",
                  "  var json = typeof Buffer !== 'undefined' ? Buffer.from(payload, 'base64').toString('utf8') : atob(payload);",
                  "  return JSON.parse(json);",
                  "}",
                  "pm.test('JWT payload has published status values [0, 1, 2]', function () {",
                  "  var payload = decodeJwtPayload(pm.response.text());",
                  "  pm.expect(payload).to.have.property('status_list');",
                  "  pm.expect(payload.status_list).to.include({ bits: 2, lst: 'eNpTAQAAJQAl' });",
                  "  pm.collectionVariables.set('pre_update_status_list_lst', payload.status_list.lst);",
                  "  pm.environment.set('pre_update_status_list_lst', payload.status_list.lst);",
                  "});",
                  "var preUpdateLastModified = pm.response.headers.get('Last-Modified') || '';",
                  "var historicalTime = Math.floor(Date.parse(preUpdateLastModified) / 1000).toString();",
                  "pm.test('pre-update server timestamp is usable for history lookup', function () {",
                  "  pm.expect(historicalTime).to.not.equal('NaN');",
                  "});",
                  "pm.collectionVariables.set('historical_time', historicalTime);",
                  "pm.environment.set('historical_time', historicalTime);",
                  "pm.collectionVariables.set('pre_update_etag', pm.response.headers.get('ETag') || '');",
                  "pm.collectionVariables.set('pre_update_last_modified', pm.response.headers.get('Last-Modified') || '');",
                  "pm.environment.set('pre_update_etag', pm.response.headers.get('ETag') || '');",
                  "pm.environment.set('pre_update_last_modified', pm.response.headers.get('Last-Modified') || '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve status list as CWT",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/statuslist+cwt"
              },
              {
                "key": "Accept-Encoding",
                "value": "identity"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/status-lists/{{list_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "status-lists",
                "{{list_id}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CWT retrieval succeeds', function () { pm.response.to.have.status(200); });",
                  "pm.test('CWT success has binary status-list headers', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/statuslist+cwt');",
                  "  pm.expect(pm.response.headers.has('ETag')).to.equal(true);",
                  "  pm.expect(pm.response.headers.get('Content-Encoding')).to.not.equal('gzip');",
                  "});",
                  "function responseBytes() {",
                  "  if (pm.response.stream) { return Array.prototype.slice.call(pm.response.stream); }",
                  "  return Array.prototype.map.call(pm.response.text(), function (c) { return c.charCodeAt(0) & 255; });",
                  "}",
                  "function bytesToBase64url(bytes) {",
                  "  return Buffer.from(bytes.__bytes).toString('base64').replace(/=/g, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "}",
                  "function CborReader(bytes) { this.bytes = bytes; this.offset = 0; }",
                  "CborReader.prototype.readByte = function () {",
                  "  if (this.offset >= this.bytes.length) { throw new Error('unexpected end of CBOR'); }",
                  "  return this.bytes[this.offset++];",
                  "};",
                  "CborReader.prototype.readLength = function (additional) {",
                  "  if (additional < 24) { return additional; }",
                  "  var lengthBytes = additional === 24 ? 1 : additional === 25 ? 2 : additional === 26 ? 4 : additional === 27 ? 8 : 0;",
                  "  if (!lengthBytes) { throw new Error('unsupported CBOR additional info ' + additional); }",
                  "  var value = 0;",
                  "  for (var i = 0; i < lengthBytes; i++) { value = value * 256 + this.readByte(); }",
                  "  return value;",
                  "};",
                  "CborReader.prototype.read = function () {",
                  "  var initial = this.readByte();",
                  "  var major = initial >> 5;",
                  "  var additional = initial & 31;",
                  "  if (major === 7) { throw new Error('unsupported CBOR simple value'); }",
                  "  var length = this.readLength(additional);",
                  "  if (major === 0) { return length; }",
                  "  if (major === 1) { return -1 - length; }",
                  "  if ((major === 2 || major === 3) && this.offset + length > this.bytes.length) { throw new Error('truncated CBOR byte/text string'); }",
                  "  if (major === 2) { return { __bytes: this.bytes.slice(this.offset, this.offset += length) }; }",
                  "  if (major === 3) { var text = this.bytes.slice(this.offset, this.offset += length); return Buffer.from(text).toString('utf8'); }",
                  "  if (major === 4) { var array = []; for (var ai = 0; ai < length; ai++) { array.push(this.read()); } return array; }",
                  "  if (major === 5) { var pairs = []; for (var mi = 0; mi < length; mi++) { pairs.push([this.read(), this.read()]); } return { __map: pairs }; }",
                  "  if (major === 6) { return { __tag: length, value: this.read() }; }",
                  "  throw new Error('unsupported CBOR major type ' + major);",
                  "};",
                  "function isByteString(value) {",
                  "  return value && Array.isArray(value.__bytes) && value.__bytes.every(function (byte) { return Number.isInteger(byte) && byte >= 0 && byte <= 255; });",
                  "}",
                  "function mapGet(map, key) {",
                  "  if (!map || !Array.isArray(map.__map)) { throw new Error('expected CBOR map'); }",
                  "  for (var i = 0; i < map.__map.length; i++) { if (map.__map[i][0] === key) { return map.__map[i][1]; } }",
                  "  throw new Error('missing CBOR map key ' + key);",
                  "}",
                  "function decodeCwtStatusList(bytes) {",
                  "  var reader = new CborReader(bytes);",
                  "  var sign1 = reader.read();",
                  "  if (reader.offset !== bytes.length) { throw new Error('trailing CBOR data after COSE_Sign1'); }",
                  "  pm.expect(sign1.__tag, 'CWT is tagged COSE_Sign1').to.equal(18);",
                  "  pm.expect(sign1.value, 'COSE_Sign1 array').to.be.an('array').with.length(4);",
                  "  pm.expect(isByteString(sign1.value[0]), 'COSE protected header is bstr').to.equal(true);",
                  "  pm.expect(sign1.value[1] && Array.isArray(sign1.value[1].__map), 'COSE unprotected header is map').to.equal(true);",
                  "  pm.expect(isByteString(sign1.value[2]), 'COSE payload is bstr').to.equal(true);",
                  "  pm.expect(isByteString(sign1.value[3]), 'COSE signature is bstr').to.equal(true);",
                  "  var payloadReader = new CborReader(sign1.value[2].__bytes);",
                  "  var payload = payloadReader.read();",
                  "  if (payloadReader.offset !== sign1.value[2].__bytes.length) { throw new Error('trailing CBOR data after CWT payload'); }",
                  "  return mapGet(payload, 65533);",
                  "}",
                  "pm.test('CWT payload has published status values [0, 1, 2]', function () {",
                  "  var statusList = decodeCwtStatusList(responseBytes());",
                  "  pm.expect(statusList && Array.isArray(statusList.__map), 'status_list claim is map').to.equal(true);",
                  "  pm.expect(mapGet(statusList, 'bits')).to.equal(2);",
                  "  var lst = mapGet(statusList, 'lst');",
                  "  pm.expect(isByteString(lst), 'status_list.lst is bstr').to.equal(true);",
                  "  pm.expect(bytesToBase64url(lst)).to.equal('eNpTAQAAJQAl');",
                  "});",
                  "pm.test('CWT decoder rejects truncated tokens', function () {",
                  "  var bytes = responseBytes();",
                  "  pm.expect(function () { decodeCwtStatusList(bytes.slice(0, -8)); }).to.throw();",
                  "});",
                  "pm.test('CWT decoder rejects arrays where byte strings are required', function () {",
                  "  var valid = [0xd2, 0x84, 0x40, 0xa0, 0x50, 0xa1, 0x19, 0xff, 0xfd, 0xa2, 0x64, 0x62, 0x69, 0x74, 0x73, 0x02, 0x63, 0x6c, 0x73, 0x74, 0x40, 0x43, 0x01, 0x02, 0x03];",
                  "  var statusList = decodeCwtStatusList(valid);",
                  "  pm.expect(isByteString(mapGet(statusList, 'lst')), 'valid control status_list.lst is bstr').to.equal(true);",
                  "  var signatureArray = [0xd2, 0x84, 0x40, 0xa0, 0x50, 0xa1, 0x19, 0xff, 0xfd, 0xa2, 0x64, 0x62, 0x69, 0x74, 0x73, 0x02, 0x63, 0x6c, 0x73, 0x74, 0x40, 0x83, 0x01, 0x02, 0x03];",
                  "  pm.expect(function () { decodeCwtStatusList(signatureArray); }).to.throw('COSE signature is bstr');",
                  "});"
                ]
              }
            }
          ]
