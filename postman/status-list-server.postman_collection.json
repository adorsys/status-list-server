{
  "info": {
    "_postman_id": "7a4f7995-b6d6-45db-a5b9-6aca732a79b6",
    "name": "Status List Server",
    "description": "Ready-to-run requests for exploring the status-list-server API. Select the included environment, set `baseUrl` and `issuer_id`, then send `Start new test run` followed by `Register issuer credentials`. The collection generates or reuses an ES256 issuer key pair, registers its public key, and signs protected writes. Set `issuer_audience` when the management server requires an audience claim.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": {
      "major": 0,
      "minor": 1,
      "patch": 0
    }
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "exec": [
          "const method = pm.request.method;",
          "const requestPath = pm.request.url.path.join('/');",
          "const isRegistration = method === 'POST' && requestPath === 'api/v1/credentials';",
          "const signWithIssuer = pm.request.headers.get('X-Postman-Sign-With-Issuer') === 'true';",
          "if (signWithIssuer) pm.request.headers.remove('X-Postman-Sign-With-Issuer');",
          "const isProtectedWrite = signWithIssuer;",
          "if (isRegistration || isProtectedWrite) {",
          "  (async function () {",
          "    const issuer = pm.variables.get('issuer_id');",
          "    if (!issuer) throw new Error('Set issuer_id before registering credentials or writing status lists.');",
          "    function decodePayload(token) {",
          "      const parts = token.split('.');",
          "      if (parts.length !== 3) throw new Error('Preconfigured token is not a JWT.');",
          "      let payload = parts[1].replace(/-/g, '+').replace(/_/g, '/');",
          "      while (payload.length % 4) payload += '=';",
          "      try { return JSON.parse(typeof Buffer !== 'undefined' ? Buffer.from(payload, 'base64').toString('utf8') : atob(payload)); } catch { throw new Error('Preconfigured token payload is invalid.'); }",
          "    }",
          "    async function waitForNextSecond() {",
          "      const lastModified = pm.variables.get('pre_update_last_modified') || pm.environment.get('pre_update_last_modified');",
          "      const updateAfter = Date.parse(lastModified) + 1100;",
          "      const delay = updateAfter - Date.now();",
          "      if (Number.isFinite(updateAfter) && delay > 0) await new Promise(resolve => setTimeout(resolve, delay));",
          "    }",
          "    let keys;",
          "    try { keys = JSON.parse(pm.environment.get('issuer_private_jwks') || '{}'); }",
          "    catch { throw new Error('issuer_private_jwks is not valid JSON; clear it and re-register.'); }",
          "    if (method === 'PATCH') await waitForNextSecond();",
          "    let privateJwk = Object.prototype.hasOwnProperty.call(keys, issuer) ? keys[issuer] : null;",
          "    if (!privateJwk && isRegistration) {",
          "      const storedToken = pm.environment.get('token') || pm.collectionVariables.get('token');",
          "      const storedPublicKey = pm.environment.get('issuer_public_key');",
          "      if (storedToken && storedPublicKey && Object.keys(keys).length === 0) {",
          "        let publicKey;",
          "        try { publicKey = JSON.parse(storedPublicKey); } catch { throw new Error('issuer_public_key is not valid JSON; clear it and re-register.'); }",
          "        if (publicKey.kid !== issuer) throw new Error(`Preconfigured key is for ${publicKey.kid}, not ${issuer}.`);",
          "        const claims = decodePayload(storedToken);",
          "        if (claims.iss !== issuer || claims.exp <= Math.floor(Date.now() / 1000) + 30) throw new Error('Preconfigured token is expired or belongs to a different issuer.');",
          "        pm.request.body.update(JSON.stringify({ issuer, public_key: publicKey }));",
          "        pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${storedToken}` });",
          "        return;",
          "      }",
          "      const keyPair = await crypto.subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, true, ['sign', 'verify']);",
          "      privateJwk = await crypto.subtle.exportKey('jwk', keyPair.privateKey);",
          "      Object.defineProperty(keys, issuer, { value: privateJwk, enumerable: true, configurable: true, writable: true });",
          "      pm.environment.set('issuer_private_jwks', JSON.stringify(keys));",
          "      pm.environment.set('issuer_public_key', JSON.stringify({ kty: privateJwk.kty, crv: privateJwk.crv, x: privateJwk.x, y: privateJwk.y, kid: issuer, alg: 'ES256' }));",
          "    }",
          "    if (!privateJwk) {",
          "      const existingToken = pm.environment.get('token') || pm.collectionVariables.get('token');",
          "      if (isProtectedWrite && existingToken) {",
          "        const claims = decodePayload(existingToken);",
          "        if (claims.iss !== issuer || claims.exp <= Math.floor(Date.now() / 1000) + 30) throw new Error('Preconfigured token is expired or belongs to a different issuer.');",
          "        const publicKey = JSON.parse(pm.environment.get('issuer_public_key') || '{}');",
          "        if (publicKey.kid !== issuer) throw new Error(`Preconfigured key is for ${publicKey.kid}, not ${issuer}.`);",
          "        pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${existingToken}` });",
          "        return;",
          "      }",
          "      throw new Error('No issuer signing key found. Send Register issuer credentials first.');",
          "    }",
          "    const publicKey = { kty: privateJwk.kty, crv: privateJwk.crv, x: privateJwk.x, y: privateJwk.y, kid: issuer, alg: 'ES256' };",
          "    pm.environment.set('issuer_public_key', JSON.stringify(publicKey));",
          "    if (isRegistration) pm.request.body.update(JSON.stringify({ issuer, public_key: publicKey }));",
          "    const privateKey = await crypto.subtle.importKey('jwk', privateJwk, { name: 'ECDSA', namedCurve: 'P-256' }, false, ['sign']);",
          "    const base64url = value => {",
          "      const bytes = typeof value === 'string' ? new TextEncoder().encode(value) : new Uint8Array(value);",
          "      let binary = '';",
          "      bytes.forEach(byte => { binary += String.fromCharCode(byte); });",
          "      return btoa(binary).replace(/=/g, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "    };",
          "    const now = Math.floor(Date.now() / 1000) - 5;",
          "    const header = base64url(JSON.stringify({ alg: 'ES256', typ: 'statuslist-management+jwt', kid: issuer }));",
          "    const payloadClaims = { iss: issuer, iat: now, exp: now + 300 };",
          "    const audience = pm.environment.get('issuer_audience');",
          "    if (audience) payloadClaims.aud = audience;",
          "    const payload = base64url(JSON.stringify(payloadClaims));",
          "    const signingInput = header + '.' + payload;",
          "    const signature = await crypto.subtle.sign({ name: 'ECDSA', hash: 'SHA-256' }, privateKey, new TextEncoder().encode(signingInput));",
          "    const token = signingInput + '.' + base64url(signature);",
          "    pm.variables.set('token', token);",
          "    if (isProtectedWrite) pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });",
          "  })().catch(error => {",
          "    pm.variables.unset('token');",
          "    throw error;",
          "  });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response has a status code', function () {",
          "  pm.expect(pm.response.code).to.be.a('number');",
          "});"
        ]
      }
    }
  ],
