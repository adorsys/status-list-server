    {
      "name": "Issuer Management",
      "item": [
        {
          "name": "Register issuer credentials",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"issuer\": \"{{issuer_id}}\",\n  \"public_key\": {{issuer_public_key}}\n}"
            },
            "url": {
              "raw": "{{managementUrl}}/api/v1/credentials",
              "host": [
                "{{managementUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "credentials"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('credentials are accepted or already registered', function () { pm.expect([202, 409]).to.include(pm.response.code); });",
                  "pm.test('response is JSON', function () { pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'); });",
                  "pm.test('response body matches expected shape', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(pm.response.code === 202 ? 'status' : 'error');",
                  "});",
                  "const expectedRegistrationStatus = pm.variables.get('expected_registration_status');",
                  "if (expectedRegistrationStatus) pm.test('Newman registration status matches expected response', function () { pm.expect(pm.response.code).to.equal(Number(expectedRegistrationStatus)); });",
                  "const issuer = pm.variables.get('issuer_id');",
                  "const token = pm.variables.get('token') || pm.environment.get('token') || pm.collectionVariables.get('token');",
                  "if (![202, 409].includes(pm.response.code)) {",
                  "  pm.test('issuer JWT is ready for protected requests', function () { throw new Error('Issuer registration failed. Fix the registration error before publishing.'); });",
                  "} else {",
                  "pm.test('issuer JWT is available and belongs to this issuer', function () {",
                  "  pm.expect(token, 'register first or provide a valid Newman token').to.be.a('string').and.not.empty;",
                  "  const parts = token.split('.');",
                  "  pm.expect(parts, 'JWT has three segments').to.have.length(3);",
                  "  let payload = parts[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "  while (payload.length % 4) payload += '=';",
                  "  const claims = JSON.parse(typeof Buffer !== 'undefined' ? Buffer.from(payload, 'base64').toString('utf8') : atob(payload));",
                  "  pm.expect(claims.iss).to.equal(issuer);",
                  "  pm.expect(claims.exp).to.be.greaterThan(Math.floor(Date.now() / 1000) + 30);",
                  "});",
                  "if (token) {",
                  "  pm.sendRequest({",
                  "    url: pm.variables.replaceIn('{{managementUrl}}/api/v1/credentials'),",
                  "    method: 'GET',",
                  "    header: { Authorization: 'Bearer ' + token }",
                  "  }, function (error, response) {",
                  "    pm.test('issuer JWT authenticates on the management API', function () {",
                  "      if (error || !response || response.code !== 200 || response.json().issuer !== issuer) throw new Error('The issuer JWT could not authenticate with this key. Restore the original private key/environment, or choose a new issuer_id and register again.');",
                  "    });",
                  "    pm.test('issuer JWT is ready for protected requests', function () {",
                  "      if (error || !response || response.code !== 200 || response.json().issuer !== issuer) throw new Error('The issuer JWT could not authenticate with this key. Restore the original private key/environment, or choose a new issuer_id and register again.');",
                  "    });",
                  "  });",
                  "} else {",
                  "  pm.test('issuer JWT is ready for protected requests', function () { throw new Error('No issuer signing key or preconfigured token is available.'); });",
                  "}",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Status Lists",
      "item": [
        {
          "name": "Publish status list",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Postman-Sign-With-Issuer",
                "value": "true",
                "description": "Collection signing marker; the pre-request script removes it before sending."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"statuses\": [\n    { \"index\": 0, \"status\": 0 },\n    { \"index\": 1, \"status\": 1 },\n    { \"index\": 2, \"status\": 2 }\n  ]\n}"
            },
            "url": {
              "raw": "{{managementUrl}}/api/v1/status-lists/{{list_id}}/statuses",
              "host": [
                "{{managementUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "status-lists",
                "{{list_id}}",
                "statuses"
              ]
